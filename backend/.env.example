ENV=dev
DATABASE_URL=postgresql+psycopg://pam:pam@localhost:5432/pam
TEST_DATABASE_URL=postgresql+psycopg://pam:pam@localhost:5432/pam_test
# 64+ random characters in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me
# Password for the four seeded demo logins (admin/analyst/reviewer/customer @pam.test)
DEMO_PASSWORD=replace-me
# Leave empty to disable Google sign-in; set to your Firebase project id to enable it
FIREBASE_PROJECT_ID=
# Comma-separated emails that become ADMIN on first Google sign-in
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:5173
DATA_DIR=../data
REPORTS_DIR=../reports
